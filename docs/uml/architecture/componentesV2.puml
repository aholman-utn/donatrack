@startuml componentesV2

skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Monospaced
skinparam component {
    BorderColor Black
    BackgroundColor White
}
skinparam package {
    BorderColor Black
    BackgroundColor White
    Style rectangle
}

title Diagrama de Componentes — DonaTrack

' ==================== Layout vertical, servicios en fila ====================

component [Cliente HTTP\n(Postman / Swagger)] as Cliente

' Fila 1: los 4 servicios lado a lado
package "Servicio de Donaciones" as ServDonaciones {
    component [Gestión Donantes] as GD
    component [Gestión Donaciones] as GDon
    component [Gestión Entidades] as GEB
    component [Matchmaking] as Match
    component [Trazabilidad] as Traz
    component [Importador CSV] as CSV
    component [Polling Logística] as Polling
    component [Cron Inactivos] as CronInact
    component [Cron Envío Logística] as CronLog
}

package "Servicio de Logística" as ServLogistica {
    component [Planificador Rutas] as Plan
    component [Gestión Camiones] as GCam
    component [Eventos Logística] as EvLog
}

package "Servicio de Notificaciones" as ServNotificaciones {
    component [Notificador] as Notif
    component [Email] as Email
    component [SMS] as SMS
    component [WhatsApp] as WA
}

package "Servicio de Incentivos" as ServIncentivos {
    component [Misiones] as Mis
    component [Ranking] as Rank
    component [Evaluador Progreso] as Eval
}

component [N8N (automatización)] as N8N
component [commons (JAR)\nNotificacionRestClient + DTOs] as Commons

' ==================== Disposición forzada ====================

ServDonaciones -[hidden]right- ServLogistica
ServNotificaciones -[hidden]right- ServIncentivos
ServDonaciones -[hidden]down- ServNotificaciones
ServLogistica -[hidden]down- ServIncentivos

' ==================== Cliente ====================

Cliente -down-> ServDonaciones
Cliente -down-> ServLogistica
Cliente -down-> ServNotificaciones
Cliente -down-> ServIncentivos

' ==================== Donaciones → Logística ====================

CronLog -right-> Plan : enviar donaciones\n(máx 100)
Polling -right-> EvLog : GET eventos\n(polling 10s)

' ==================== Donaciones → Notificaciones ====================

Traz -down-> Commons
CronInact -down-> Commons
Commons -down-> Notif : POST /notificar

' ==================== Donaciones → Incentivos ====================

Traz -right-> Eval : evento entrega

' ==================== Incentivos → Donaciones ====================

Eval -left-> GDon : consultar indicadores

' ==================== Incentivos → N8N ====================

Rank -down-> N8N : webhook insignia

' ==================== Notificaciones internas ====================

Notif -down-> Email
Notif -down-> SMS
Notif -down-> WA

' ==================== Notas ====================

note right of ServLogistica
    Servicio pasivo: no invoca
    otros servicios. Solo expone
    eventos para polling.
end note

note bottom of Polling
    Detecta INICIO_RUTA y
    ENTREGA_FALLIDA. Transiciona
    estados y notifica.
end note

@enduml
